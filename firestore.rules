rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function workspaceData(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && (
        workspaceData(workspaceId).ownerUserId == request.auth.uid ||
        workspaceData(workspaceId).memberRoles[request.auth.uid] in ['owner', 'lead', 'member']
      );
    }

    function isWorkspaceAdmin(workspaceId) {
      return isSignedIn() && (
        workspaceData(workspaceId).ownerUserId == request.auth.uid ||
        workspaceData(workspaceId).memberRoles[request.auth.uid] in ['owner', 'lead']
      );
    }

    // Invitee joining: may only add their own uid to memberRoles (member|lead), nothing else.
    function isSelfJoiningWorkspace() {
      let beforeRoles = resource.data.get('memberRoles', {});
      let afterRoles = request.resource.data.get('memberRoles', {});
      let rolesDiff = afterRoles.diff(beforeRoles);
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberRoles', 'updatedAt'])
        && rolesDiff.addedKeys().hasOnly([request.auth.uid])
        && rolesDiff.removedKeys().size() == 0
        && rolesDiff.changedKeys().size() == 0
        && afterRoles[request.auth.uid] in ['member', 'lead'];
    }

    // After joining: member may only append their own uid to a project's allowedUserIds.
    function isSelfAddingProjectAccess() {
      let before = resource.data.get('allowedUserIds', []);
      let after = request.resource.data.get('allowedUserIds', []);
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedUserIds', 'updatedAt'])
        && !(request.auth.uid in before)
        && request.auth.uid in after
        && after.hasAll(before)
        && after.size() == before.size() + 1;
    }

    // Targets page: workspace admins always; members only if listed on workspace.
    function canAccessTargets(workspaceId) {
      return isWorkspaceAdmin(workspaceId)
        || (
          isWorkspaceMember(workspaceId)
          && request.auth.uid in workspaceData(workspaceId).get('targetsAllowedUserIds', [])
        );
    }

    function targetData(workspaceId, targetId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/targets/$(targetId)).data;
    }

    function hasAcceptedTargetShare(workspaceId, targetId) {
      let t = targetData(workspaceId, targetId);
      return isSignedIn()
        && t.get('shareEnabled', false) == true
        && t.get('shareToken', null) is string
        && exists(/databases/$(database)/documents/targetShares/$(t.shareToken))
        && get(/databases/$(database)/documents/targetShares/$(t.shareToken)).data.get('enabled', true) != false
        && request.auth.uid in get(/databases/$(database)/documents/targetShares/$(t.shareToken)).data.get('acceptedUserIds', []);
    }

    function isTargetCollaborator(workspaceId, targetId) {
      return isSignedIn() && (
        request.auth.uid in targetData(workspaceId, targetId).get('sharedWithUserIds', [])
        || hasAcceptedTargetShare(workspaceId, targetId)
      );
    }

    // Outsider accepting an invite link: may only append their own uid to acceptedUserIds.
    function isAcceptingTargetShare() {
      let before = resource.data.get('acceptedUserIds', []);
      let after = request.resource.data.get('acceptedUserIds', []);
      // Accept may also normalize legacy invite docs (enabled / permission).
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn()
        && resource.data.get('enabled', true) != false
        && keys.hasOnly(['acceptedUserIds', 'updatedAt', 'enabled', 'permission'])
        && !(request.auth.uid in before)
        && request.auth.uid in after
        && after.hasAll(before)
        && after.size() == before.size() + 1;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                    request.resource.data.actorId == request.auth.uid &&
                    request.resource.data.userId is string;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Collection group reads for tasks / subtasks / comments
    match /{path=**}/tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /{path=**}/subtasks/{subtaskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Attendance: no open collectionGroup write; hierarchical rules below own access.
    match /{path=**}/attendance/{attendanceId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        (resource.data.workspaceId is string && isWorkspaceAdmin(resource.data.workspaceId))
      );
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId);
    }

    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isWorkspaceMember(workspaceId) || isSelfJoiningWorkspace();
      allow delete: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;

      match /members/{memberUserId} {
        allow read: if isSignedIn();
        allow create, update: if isWorkspaceAdmin(workspaceId) || isSelf(memberUserId);
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      match /attendance/{attendanceId} {
        allow read: if isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          isWorkspaceAdmin(workspaceId)
        );
        allow create: if isSignedIn() &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.workspaceId == workspaceId;
        allow update: if isSignedIn() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if false;
      }

      match /projects/{projectId} {
        allow read: if isSignedIn();
        allow create: if isWorkspaceAdmin(workspaceId);
        allow update: if isWorkspaceAdmin(workspaceId)
          || (isWorkspaceMember(workspaceId) && isSelfAddingProjectAccess());
        allow delete: if isWorkspaceAdmin(workspaceId);

        match /tasks/{taskId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isWorkspaceMember(workspaceId);

          match /subtasks/{subtaskId} {
            allow read: if isSignedIn();
            allow write: if isWorkspaceMember(workspaceId);
          }

          match /comments/{commentId} {
            allow read: if isSignedIn();
            allow create: if isWorkspaceMember(workspaceId) &&
                          request.resource.data.authorUserId == request.auth.uid;
            allow update, delete: if isWorkspaceMember(workspaceId) &&
                                  resource.data.authorUserId == request.auth.uid;
          }
        }
      }

      match /targets/{targetId} {
        allow read: if canAccessTargets(workspaceId) || isTargetCollaborator(workspaceId, targetId);
        allow create: if canAccessTargets(workspaceId)
          && request.resource.data.createdByUserId == request.auth.uid
          && request.resource.data.workspaceId == workspaceId;
        allow update: if canAccessTargets(workspaceId) || isTargetCollaborator(workspaceId, targetId);
        allow delete: if canAccessTargets(workspaceId);
      }
    }

    // Invite links for targets (token in URL is the secret). Edit access after accept — not view-only.
    match /targetShares/{token} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.workspaceId is string
        && canAccessTargets(request.resource.data.workspaceId);
      allow update: if isSignedIn() && (
        canAccessTargets(resource.data.workspaceId)
        || isAcceptingTargetShare()
      );
      allow delete: if isSignedIn()
        && resource.data.workspaceId is string
        && canAccessTargets(resource.data.workspaceId);
    }

    match /invitations/{invitationId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
  }
}
