rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function workspaceData(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function isWorkspaceMember(workspaceId) {
      return isSignedIn() && (
        workspaceData(workspaceId).ownerUserId == request.auth.uid ||
        workspaceData(workspaceId).memberRoles[request.auth.uid] in ['owner', 'lead', 'member']
      );
    }

    function isWorkspaceAdmin(workspaceId) {
      return isSignedIn() && (
        workspaceData(workspaceId).ownerUserId == request.auth.uid ||
        workspaceData(workspaceId).memberRoles[request.auth.uid] in ['owner', 'lead']
      );
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
                    request.resource.data.actorId == request.auth.uid &&
                    request.resource.data.userId is string;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- COLLECTION GROUP (required for collectionGroup() queries) ---
    match /{path=**}/tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /{path=**}/subtasks/{subtaskId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /{path=**}/attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSelf(userId);
    }

    // --- WORKSPACES ---
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isWorkspaceMember(workspaceId);
      allow delete: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;

      match /members/{memberUserId} {
        allow read: if isSignedIn();
        allow create, update: if isWorkspaceAdmin(workspaceId) || isSelf(memberUserId);
        allow delete: if isWorkspaceAdmin(workspaceId);
      }

      // Keep hierarchical attendance aligned with collectionGroup reads.
      // App still filters "own vs admin" client-side.
      match /attendance/{attendanceId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() &&
          request.auth.uid == request.resource.data.userId;
        allow delete: if false;
      }

      match /projects/{projectId} {
        allow read: if isSignedIn();
        allow create: if isWorkspaceAdmin(workspaceId);
        allow update, delete: if isWorkspaceAdmin(workspaceId);

        match /tasks/{taskId} {
          allow read: if isSignedIn();
          allow create, update, delete: if isWorkspaceMember(workspaceId);

          match /subtasks/{subtaskId} {
            allow read: if isSignedIn();
            allow write: if isWorkspaceMember(workspaceId);
          }

          match /comments/{commentId} {
            allow read: if isSignedIn();
            allow create: if isWorkspaceMember(workspaceId) &&
                          request.resource.data.authorUserId == request.auth.uid;
            allow update, delete: if isWorkspaceMember(workspaceId) &&
                                  resource.data.authorUserId == request.auth.uid;
          }
        }
      }
    }

    // --- INVITATIONS (public read needed for join links) ---
    match /invitations/{invitationId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
  }
}
